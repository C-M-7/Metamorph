# Application & Web Ports
PORT=8080
WEB_PORT=3000

# MySQL Database Configuration
DB_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=metamorph_db
MYSQL_USER=metamorph_user
MYSQL_PASSWORD=metamorph_password
MYSQL_ROOT_PASSWORD=root

# Security keys
JWT_ACCESS_SECRET=your_jwt_access_secret_key_base64
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_base64
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# Client & Cookie configuration
CLIENT_URL=http://localhost:3000
COOKIE_SECURE=false


#AWS-Credentials
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
